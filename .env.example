# Frontend (Vite, zur Build-Zeit eingebettet)
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Optional: mailto-Adresse für Massa-Sammelbestellung (sonst nur Simulation, kein Versand)
# VITE_MASSA_MAILTO=

# Cloudflare Pages Functions (Dashboard → Settings → Environment variables)
# SUPABASE_URL=https://<projekt>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# GEMINI_API_KEY=<optional, PDF-Analyse>

# Supabase Edge Function create-user (automatisch vorhanden nach `supabase functions deploy`)
# SUPABASE_SERVICE_ROLE_KEY niemals ins Frontend oder ins Git legen.
# Zusätzliche Browser-Origins (kommagetrennt), nie *
# ALLOWED_ORIGINS=https://bekleidung.example.at
